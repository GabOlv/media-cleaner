{
  "expo": {
    "name": "MediaCleaner",
    "slug": "media-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/media-cleaner.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gabriel.mediacleaner",
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF7",
        "foregroundImage": "./assets/media-cleaner-adaptive.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o MediaCleaner acesse fotos e vídeos para você revisar e escolher o que manter ou excluir.",
          "savePhotosPermission": "Permitir que o MediaCleaner salve fotos na biblioteca quando solicitado.",
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF7",
          "image": "./assets/media-cleaner.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "favicon": "./assets/media-cleaner.png"
    }
  }
}
